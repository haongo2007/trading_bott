# ───── MySQL ─────
# Dev (máy local, docker-compose, cổng 3317):
#   DATABASE_URL="mysql://bot:botpass@127.0.0.1:3317/bot_trading?allowPublicKeyRetrieval=true"
# VPS (MySQL cài bằng apt, cổng 3306) — xem deploy/DEPLOY.md:
#   DATABASE_URL="mysql://bot_trading:<mật-khẩu>@127.0.0.1:3306/bot_trading?allowPublicKeyRetrieval=true"
# allowPublicKeyRetrieval=true là BẮT BUỘC với MySQL 8 (caching_sha2_password): thiếu nó app sẽ
# không kết nối được sau khi MySQL khởi động lại. Mật khẩu có ký tự đặc biệt phải mã hoá URL (VD @ → %40).
DATABASE_URL="mysql://bot:botpass@127.0.0.1:3317/bot_trading?allowPublicKeyRetrieval=true"

# Auth.js — tạo bằng: npx auth secret  (hoặc openssl rand -base64 33)
AUTH_SECRET=""

# Khoá mã hoá thông tin đăng nhập sàn — openssl rand -base64 32
# MẤT KHOÁ NÀY = KHÔNG GIẢI MÃ ĐƯỢC MẬT KHẨU ĐÃ LƯU. Hãy backup an toàn.
ENCRYPTION_KEY=""

# Admin đầu tiên (npm run db:seed)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""

# ───── Web (PM2 đọc 2 biến này từ .env) ─────
WEB_PORT=3000
# 127.0.0.1 = chỉ nội bộ (có Nginx phía trước) · 0.0.0.0 = truy cập thẳng http://<IP>:<WEB_PORT>
WEB_HOST="127.0.0.1"

# ───── Worker (Playwright + WebSocket) ─────
# Bí mật ký token kết nối canvas ↔ worker — openssl rand -base64 48
WORKER_SECRET=""
WORKER_HOST="127.0.0.1"
WORKER_PORT=3001
# Next.js server gọi health-check worker
WORKER_HTTP_URL="http://127.0.0.1:3001"
# URL WebSocket mà TRÌNH DUYỆT của người dùng kết nối tới (production: wss://domain/live qua Nginx)
WORKER_PUBLIC_WS_URL="ws://localhost:3001/live"
# Chỉ chấp nhận kết nối WS từ origin của dashboard
APP_ORIGIN="http://localhost:3000"
# false = hiện cửa sổ Chromium (debug local)
WORKER_HEADLESS=true
MAX_BROWSER_CONTEXTS=8
STORAGE_DIR="storage"

# ───── AI dự đoán hướng (tuỳ chọn) ─────
# Khoá API Claude cho worker — chỉ cần khi bot dùng chế độ "AI dự đoán"
ANTHROPIC_API_KEY=""
MAX_BOT_RUNS=6

# Telegram API (để mặc định; chỉ đổi khi test với server giả lập)
# TELEGRAM_API_BASE="https://api.telegram.org"

# ───── Proxy cho trình duyệt của worker (tuỳ chọn) ─────
# Chỉ cần khi chạy worker ở máy local mà nhà mạng chặn website sàn. Trên VPS để trống.
#   1) Mở tunnel qua VPS:  ssh -N -D 1080 user@your-vps
#   2) Đặt:                WORKER_PROXY_SERVER="socks5://127.0.0.1:1080"
# localhost/127.0.0.1 luôn truy cập trực tiếp (sàn giả lập không bị ảnh hưởng).
WORKER_PROXY_SERVER=""

# ───── Hiệu năng trình duyệt trên server ─────
# Chất lượng JPEG của màn hình trực tiếp (30–80). Thấp hơn = mượt hơn trên mạng chậm.
WORKER_SCREENCAST_QUALITY=55
# true = bot chạy nền không tải ảnh/font/video (giảm CPU/RAM). Không ảnh hưởng màn hình trực tiếp.
WORKER_BLOCK_HEAVY=false
